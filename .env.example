# Copy to .env and adjust. Every setting can also be passed as an environment variable.

# --- Application ---
# One of: development | staging | production | test
ENVIRONMENT=development
DEBUG=false
# Set false to hide /docs, /redoc and /openapi.json
DOCS_ENABLED=true

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database ---
# Local dev uses SQLite; docker-compose overrides DATABASE_URL with Postgres.
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# Used by docker-compose only
POSTGRES_PASSWORD=change-me
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Storage & analytics ---
STORAGE_DIR=./data/datasets
MAX_UPLOAD_SIZE_MB=100
MAX_RESULT_ROWS=10000

# --- DuckDB analytics engine ---
# Leave unset for DuckDB defaults: all cores, 80% of RAM, spill under STORAGE_DIR/.duckdb_tmp
# DUCKDB_THREADS=4
# DUCKDB_MEMORY_LIMIT=4GB
# DUCKDB_TEMP_DIR=/data/duckdb_tmp

# --- AI analyst (Claude API) ---
# Leave unset to let the SDK use ANTHROPIC_AUTH_TOKEN or an `ant auth login` profile.
# ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
AI_EFFORT=medium
AI_MAX_TOOL_ROUNDS=4
# Max rows any single tool result can contain (sent to Claude and returned to clients)
AI_MAX_TOOL_ROWS=200
AI_TIMEOUT_SECONDS=120
AI_STRICT_TOOLS=true
# Retry safety-classifier refusals on another model instead of failing
AI_FALLBACKS_ENABLED=true
# Free local stand-in for Claude: keyword matching, template answers, no API key or cost.
# Not allowed with ENVIRONMENT=production.
AI_DEMO_MODE=false

# --- Logging ---
LOG_LEVEL=INFO
# Use true in production for log aggregation
LOG_JSON=false
