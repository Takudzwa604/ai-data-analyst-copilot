# Copy to .env and adjust. Every setting can also be passed as an environment variable.

# --- Application ---
# One of: development | staging | production | test
ENVIRONMENT=development
DEBUG=false
# Set false to hide /docs, /redoc and /openapi.json
DOCS_ENABLED=true

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database ---
# Local dev uses SQLite; docker-compose overrides DATABASE_URL with Postgres.
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# Used by docker-compose only
POSTGRES_PASSWORD=change-me
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Storage & analytics ---
STORAGE_DIR=./data/datasets
MAX_UPLOAD_SIZE_MB=100
# Parsed datasets kept in memory per worker process
DATAFRAME_CACHE_SIZE=16
MAX_RESULT_ROWS=10000

# --- Logging ---
LOG_LEVEL=INFO
# Use true in production for log aggregation
LOG_JSON=false
